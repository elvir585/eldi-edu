Options -Indexes
<FilesMatch "^(config\.example|service|section-service|section-tests|complete-service|school-runtime|practical-tasks|staff-service|cleanup-service)\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "no-store"
</IfModule>
<Files "api.php">
  Require all granted
</Files>

<Files "classroom-119.php">
  Require all granted
</Files>

<Files "classroom-132.php">
  Require all granted
</Files>

<Files "classroom-staff.php">
  Require all granted
</Files>

<Files "classroom-cleanup.php">
  Require all granted
</Files>
