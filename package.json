{
  "name": "eldi-edu",
  "version": "10.5.1",
  "private": true,
  "description": "ELDI EDU — desktop aplikacija za matematiku i informatiku od 5. do 9. razreda",
  "main": "desktop/main.cjs",
  "author": "Dino Isanović, Elvir Čajić, Damir Bajrić i Jasmin Suljkanović",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node scripts/check.cjs --runtime",
    "runtime:bundle": "node scripts/build-runtime.cjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "electron . --smoke-test",
    "prestart": "node scripts/generate-content.cjs && node scripts/build-learning-pack.cjs && node scripts/build-block-projects.cjs && node scripts/build-block-pack.cjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ba.eldi.edu.desktop",
    "productName": "ELDI EDU",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "renderer/**/*",
      "app/**/*",
      "content/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ELDI-EDU-${version}-${arch}.${ext}",
      "icon": "renderer/assets/eldi.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ELDI EDU",
      "artifactName": "ELDI-EDU-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ELDI-EDU-${version}-Portable-${arch}.${ext}"
    }
  }
}
