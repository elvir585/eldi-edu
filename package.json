{
  "name": "eldi-edu",
  "version": "33.33.0",
  "private": true,
  "description": "ELDI EDU — desktop aplikacija za matematiku i informatiku od 5. do 9. razreda",
  "main": "desktop/main.cjs",
  "author": "Dino Isanović, Elvir Čajić, Damir Bajrić i Jasmin Suljkanović",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node scripts/check.cjs --runtime",
    "runtime:bundle": "node scripts/build-runtime.cjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "electron . --smoke-test",
    "prestart": "npm run studio33:bundle && npm run editor:bundle && npm run lab:bundle && node scripts/generate-content.cjs && node scripts/build-learning-pack.cjs && node scripts/build-block-projects.cjs && node scripts/build-block-pack.cjs && node scripts/build-assessment-pack.cjs && node scripts/build-scratch.cjs",
    "scratch:bundle": "node scripts/build-scratch.cjs",
    "chatgpt:bundle": "node scripts/build-codex.cjs",
    "assessments:verify": "node scripts/verify-program-assessments.cjs",
    "editor:bundle": "node scripts/build-editor.cjs",
    "lab:bundle": "node scripts/build-lab.cjs",
    "studio33:bundle": "node scripts/build-studio33.cjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@xmldom/xmldom": "0.9.12",
    "acorn": "8.15.0",
    "codemirror": "6.0.2",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "jsxgraph": "1.14.0",
    "sql.js": "1.14.1",
    "three": "0.186.1"
  },
  "build": {
    "appId": "ba.eldi.edu.desktop",
    "productName": "ELDI EDU",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "renderer/**/*",
      "app/**/*",
      "content/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "!content/packs/*-Scratch-izvori.zip"
    ],
    "extraResources": [
      {
        "from": "runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ELDI-EDU-${version}-${arch}.${ext}",
      "icon": "renderer/assets/eldi.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ELDI EDU",
      "artifactName": "ELDI-EDU-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ELDI-EDU-${version}-Portable-${arch}.${ext}"
    }
  }
}
